+            <tbody>
+              {linha.grupos.map((g) => (
+                <tr key={g.nome} data-grupo-nervuras={g.nome}>
+                  <td className="l">{g.nome}</td><td className="l">{g.nervuras}</td><td>{f2(g.L)}</td><td>{f2(g.mPos)}</td><td>{f2(g.mNeg[0])} / {f2(g.mNeg[1])}</td><td>{f2(g.Vmax)}</td>
